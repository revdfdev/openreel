<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ============ PERMISSIONS (kept to the four modules only) ============ -->

    <!-- Streaming, torrent, share all need network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Local Wi-Fi device-to-device share -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="tiramisu" />
    <!-- Wi-Fi Direct peer discovery needed location before API 33 only -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="32" />

    <!-- QR pairing for share -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Local media playback -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Background playback + ongoing torrent/share -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.wifi.direct" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".OpenReelApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.OpenReel">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Player: also opens video files from other apps / file managers -->
        <activity
            android:name=".player.PlayerActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:theme="@style/Theme.OpenReel.Player">
            <!--
              Separate filters on purpose. Android requires an intent to match
              EVERY attribute a filter declares, so a single filter carrying
              both schemes and android:mimeType only matches intents that have
              a MIME type. That silently excluded magnet: links and bare
              http(s) stream URLs, which carry no type.
            -->

            <!-- Local files handed over with a proper MIME type -->
            <intent-filter android:priority="1">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/x-mpegURL" />
                <data android:mimeType="application/vnd.apple.mpegurl" />
                <data android:mimeType="application/sdp" />
            </intent-filter>

            <!-- Network streams: no MIME type is supplied for these -->
            <intent-filter android:priority="1">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:scheme="rtsp" />
                <data android:scheme="rtmp" />
                <data android:scheme="rtmps" />
                <data android:scheme="mms" />
                <data android:scheme="mmsh" />
                <data android:scheme="ftp" />
                <data android:scheme="smb" />
            </intent-filter>

            <!-- Shared from another app ("Share > OpenReel") to play it -->
            <intent-filter android:priority="1">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
            </intent-filter>

            <!--
              A link shared from a browser arrives as text/plain, not as a
              media type, so network streams are only reachable from the share
              sheet if we accept it. incomingUri() keeps http(s)/rtsp/magnet
              text and ignores anything else, so sharing ordinary text here is
              a no-op rather than a broken player.
            -->
            <intent-filter android:priority="1">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- Magnet links for the torrent path -->
            <intent-filter android:priority="1">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="magnet" />
            </intent-filter>

            <!--
              Extension fallback. File managers routinely hand over
              application/octet-stream or */* for mkv, avi, ts and friends, so
              match on the filename as well or OpenReel never appears in the
              chooser for exactly the formats libmpv is best at.
            -->
            <intent-filter android:priority="1">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:mimeType="application/octet-stream" />
                <data android:host="*" />
                <data android:pathPattern=".*\.mkv" />
                <data android:pathPattern=".*\.avi" />
                <data android:pathPattern=".*\.flv" />
                <data android:pathPattern=".*\.ts" />
                <data android:pathPattern=".*\.m2ts" />
                <data android:pathPattern=".*\.wmv" />
                <data android:pathPattern=".*\.webm" />
                <data android:pathPattern=".*\.mov" />
                <data android:pathPattern=".*\.mpg" />
                <data android:pathPattern=".*\.mpeg" />
                <data android:pathPattern=".*\.ogv" />
                <data android:pathPattern=".*\.rmvb" />
                <data android:pathPattern=".*\.vob" />
                <data android:pathPattern=".*\.divx" />
                <data android:pathPattern=".*\.m4v" />
                <data android:pathPattern=".*\.3gp" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:label="@string/settings" />

        <activity
            android:name=".share.ShareActivity"
            android:exported="true"
            android:label="@string/tab_share">
            <!--
              Appear in the system share sheet so files can be sent straight
              from a gallery or file manager over Wi-Fi Direct.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- Background audio / PiP keep-alive -->
        <service
            android:name=".player.PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Torrent download/seed engine -->
        <service
            android:name=".torrent.TorrentService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Local Wi-Fi file transfer server -->
        <service
            android:name=".share.ShareService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
